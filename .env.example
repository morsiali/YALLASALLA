# Copy to .env — placeholders only. NEVER commit real secrets.
# Local dev values below only work against the local seed database.
NODE_ENV=development
PORT=4000
PUBLIC_WEB_ORIGIN=http://localhost:5173

# Postgres. OWNER runs migrations; APP is subject to RLS; SERVICE bypasses RLS (server-only!).
DATABASE_URL=postgres://yalasala_owner:owner_dev_pw@localhost:54329/yalasala
APP_DATABASE_URL=postgres://yalasala_app:app_dev_pw@localhost:54329/yalasala
SERVICE_DATABASE_URL=postgres://yalasala_service:service_dev_pw@localhost:54329/yalasala
APP_DB_PASSWORD=app_dev_pw
SERVICE_DB_PASSWORD=service_dev_pw

# Auth / signing (generate long random values in production)
AUTH_SECRET=change-me-dev-only-auth-secret-0123456789
MEDIA_SIGNING_SECRET=change-me-dev-only-media-secret-0123456789
PAYMENT_WEBHOOK_SECRET=change-me-dev-only-webhook-secret

# Provider modes: mock | sandbox | live  (see docs/PROVIDERS.md)
OTP_PROVIDER=mock
PAYMENT_PROVIDER=sandbox
AI_PROVIDER=rules          # rules | anthropic
TRANSCRIPTION_PROVIDER=mock
STORAGE_PROVIDER=local
NOTIFICATION_PROVIDER=inapp
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
STORAGE_DIR=./storage

# Business rules
CASH_ON_DELIVERY_ENABLED=true
AUTO_SUBSTITUTION_MAX_INCREASE_PCT=15
