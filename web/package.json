    "@capacitor/ios": "^6.2.0",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript": "^5.6.3",
