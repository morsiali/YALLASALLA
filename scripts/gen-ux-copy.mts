// Generates docs/UX-COPY.md from the typed dictionaries so the copy document can never drift from the product.
import fs from 'node:fs';
import { en } from '../web/src/i18n/en.ts';
import { ar } from '../web/src/i18n/ar.ts';

const groups: [string, string, RegExp][] = [
  ['Brand, CTAs and navigation', 'Core', /^(brand|cta|nav)\./],
  ['Service area and location consent', 'Location', /^area\./],
  ['Home page', 'Home', /^(home|footer|faq)\./],
  ['Basket builder', 'Builder', /^(builder|diet|allergen)\./],
  ['Basket, budget and alternatives', 'Basket', /^(basket|budget|group|item|alt)\./],
  ['Why this basket? (explanations)', 'Why', /^(why|fact)\./],
  ['Ready baskets and stores', 'Stores', /^(ready|stores)\./],
  ['Messaging, voice and consent', 'Chat', /^chat\./],
  ['Checkout and payments', 'Checkout', /^checkout\./],
  ['Orders, tracking and substitutions', 'Orders', /^(order|status|subst|repeat)\./],
  ['Points and loyalty', 'Loyalty', /^loyalty\./],
  ['Account, privacy and consent', 'Account', /^(auth|profile|saved|help|legal)\./],
  ['Notifications', 'Notif', /^notif\./],
  ['Errors and recovery', 'Errors', /^error\./],
  ['Merchant console', 'Merchant', /^m\./],
  ['Administration', 'Admin', /^a\./],
  ['Test-mode labels', 'Modes', /^mode\./],
  ['Common', 'Common', /^(common|unit|time|days)\./],
];
const esc = (s: string) => s.replace(/\|/g, '\\|').replace(/\n/g, ' ');
let md = `# Bilingual UX copy\n\n> Generated by \`npx tsx scripts/gen-ux-copy.mts\` from \`web/src/i18n/en.ts\` and \`ar.ts\`. Do not edit by hand.\n> Arabic is Modern Standard Arabic suited to UAE readers. Placeholders such as \`{amount}\` are filled at runtime (amounts are formatted as \`AED 490.00\` / \`490.00 درهم\`).\n> Legal text (terms/privacy) is **placeholder** and requires qualified review before launch.\n\n`;
const used = new Set<string>();
for (const [title, , re] of groups) {
  const keys = Object.keys(en).filter((k) => re.test(k) && !used.has(k));
  if (!keys.length) continue;
  md += `## ${title}\n\n| Key | English | العربية |\n|---|---|---|\n`;
  for (const k of keys) { used.add(k); md += `| \`${k}\` | ${esc(en[k as keyof typeof en])} | ${esc(ar[k as keyof typeof ar])} |\n`; }
  md += '\n';
}
fs.writeFileSync('docs/UX-COPY.md', md);
console.log(`docs/UX-COPY.md: ${used.size} strings`);
